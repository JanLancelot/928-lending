# Cloudflare Turnstile CAPTCHA Keys
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...

# Optional: Skip Turnstile verification in local development (true/false)
SKIP_TURNSTILE=false

# HMAC Payload Verification Key & Bypass
HMAC_SECRET_KEY=your_hmac_secret_key_here
SKIP_HMAC=false

# Sentry Error Monitoring DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# API Rate Limiting Configuration (Defaults to 5 requests per 60 seconds)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Email Delivery (Resend / SES) - Dev 2
RESEND_API_KEY=re_...
SENDER_EMAIL=notifications@yourverifieddomain.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com
ADMIN_CC_EMAIL=cc@example.com
NOTIFICATION_EMAIL_RECIPIENT=applications@928lending.com

# Twilio SMS Credentials - Dev 2
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# PDF Encryption & Decryption
PDF_DECRYPTION_PASSWORD=your_secure_pdf_decryption_password_here
